# ==============================================
# FlinkServe Backend — Environment Configuration
# Copy these variables into your Render.com dashboard
# (Dashboard → your service → Environment)
# ==============================================

# Application
NODE_ENV=production
# PORT is set automatically by Render — do not define it

# Database (MongoDB Atlas — use your existing cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/flinkserve?retryWrites=true&w=majority&appName=Cluster0

# JWT — generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=9/L4s81KEirUEQthplIb3e27tBLDa7B2QvsXPqHSNAQVWPwam5G3PkdAVY41tq0z
JWT_EXPIRES_IN=30d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://flinkserve.web.app,https://flinkserve.firebaseapp.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Optional — Cloudinary (recommended for persistent file storage; Render's free
# disk is ephemeral, so uploaded files are lost on redeploy/restart)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional — Email
# EMAIL_FROM=noreply@flinkserve.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=