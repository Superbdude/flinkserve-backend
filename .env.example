# ==============================================
# FlinkServe Backend — Environment Configuration
# Copy these variables into your Render.com dashboard
# (Dashboard → your service → Environment)
# ==============================================

# Application
NODE_ENV=production
# PORT is set automatically by Render — do not define it

# Database (MongoDB Atlas — use your own cluster connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/flinkserve?retryWrites=true&w=majority&appName=Cluster0
# MONGODB_TEST_URI=          # Optional — used by the test suite only

# JWT — generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://flinkserve.web.app,https://flinkserve.firebaseapp.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Social sign-in (OPTIONAL — required only if you want Google/Facebook buttons)
# ---------------------------------------------------------------------------

# Google: the OAuth client ID must match the frontend's VITE_GOOGLE_CLIENT_ID.
# Optional, but setting it makes the backend reject tokens issued for other apps.
# GOOGLE_CLIENT_ID=

# Facebook: APP_ID must match the frontend's VITE_FACEBOOK_APP_ID.
# APP_SECRET is a real secret — never expose it in the frontend.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Optional — Cloudinary (recommended for persistent file storage; Render's free
# disk is ephemeral, so uploaded files are lost on redeploy/restart)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional — Email
# EMAIL_FROM=noreply@flinkserve.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=